# Neon pooled connection for importer/application queries (StatsArena only).
DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE-POOLER.REGION.AWS.NEON.TECH/statsarena?sslmode=require

# Neon direct connection for Drizzle migrations (StatsArena only).
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@EP-EXAMPLE.REGION.AWS.NEON.TECH/statsarena?sslmode=require

# Optional local paths and fetch controls.
STATSARENA_SNAPSHOT_DIR=ingest/snapshots
STATSARENA_AUDIT_DIR=ingest/audit
STATSARENA_FETCH_TIMEOUT_MS=20000
STATSARENA_FETCH_CONCURRENCY=3
STATSARENA_FETCH_RETRIES=3
STATSARENA_SYNC_INTERVAL_SECONDS=900
STATSARENA_FIXTURE_PAGE_LIMIT=100

# Cache TTL in milliseconds; 0 disables cache reuse for that page type.
STATSARENA_CACHE_COMPETITION_MS=30000
STATSARENA_CACHE_REGISTRY_MS=21600000
STATSARENA_CACHE_STANDINGS_MS=120000
STATSARENA_CACHE_COMPLETE_MS=86400000
# For 30 minutes after a completed fixture or correction is first observed.
STATSARENA_CACHE_RECENT_COMPLETE_MS=60000
